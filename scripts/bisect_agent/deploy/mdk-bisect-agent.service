[Unit]
Description=MDK Revert-Only Bisect Agent Poll
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mdk-bot
Group=mdk-bot
Slice=mdk-bisect.slice
WorkingDirectory=/srv/mdk/repo
EnvironmentFile=/srv/mdk/env
Environment=TMPDIR=/tmp
Environment=CARGO_TERM_COLOR=never
Environment=CARGO_INCREMENTAL=0
Environment=CARGO_PROFILE_DEV_DEBUG=0
Environment=CARGO_PROFILE_TEST_DEBUG=0
# Scrubbing the child environment is hygiene only. Full OS-level isolation for
# `--live` requires `--predicate-runner-prefix` (e.g. `sudo -n -u mdk-runner --`)
# with an unprivileged `mdk-runner` user that has zero access to `/home/mdk-bot`
# credentials, SSH signing keys, or the signing checkout.
# Add `--live --predicate-runner-prefix "sudo -n -u mdk-runner --"` once dry-run
# output and the `mdk-runner` boundary are verified on the host.
ExecStart=/usr/bin/flock -n /srv/mdk/state/bisect-agent.lock /usr/bin/python3 -m scripts.bisect_agent poll --repo marmot-protocol/mdk --repo-dir /srv/mdk/repo --state-file /srv/mdk/state/bisect-state.json --canary-status /srv/mdk/state/canary-status.json --roster /srv/mdk/bisect-roster.json --worktree-root /srv/mdk/worktrees/bisect --cargo-target-dir /srv/mdk/target-bisect --bisect-budget-secs 3600
StandardOutput=journal
StandardError=journal
TimeoutStartSec=7200
