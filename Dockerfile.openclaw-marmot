FROM rust:1.97.1-bookworm AS rust-toolchain

FROM node:24.22.1-bookworm AS openclaw-runtime

ARG OPENCLAW_VERSION=2026.10.10

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git libssl-dev pkg-config qrencode tini xxd \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable \
    && corepack prepare pnpm@10.13.1 --activate

# Run the host and plugin SDK from one audited, frozen dependency graph. A
# separate global npm install would bypass the security overrides and could
# resolve a different SDK instance from the one the plugin was tested against.
WORKDIR /work/mdk/integrations/openclaw/marmot
COPY integrations/openclaw/marmot/package.json integrations/openclaw/marmot/pnpm-lock.yaml integrations/openclaw/marmot/pnpm-workspace.yaml integrations/openclaw/marmot/.npmrc ./
RUN node -e 'const expected = process.argv[1]; const actual = require("./package.json").devDependencies.openclaw; if (expected !== actual) { console.error("OPENCLAW_VERSION must match the committed SDK pin and lockfile"); process.exit(1); }' "$OPENCLAW_VERSION" \
    && pnpm install --frozen-lockfile \
    && ln -s /work/mdk/integrations/openclaw/marmot/node_modules/openclaw/openclaw.mjs /usr/local/bin/openclaw

FROM openclaw-runtime AS openclaw-marmot
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

WORKDIR /work/mdk
COPY . .

# Keep compiler output out of the image and reuse it when only plugin code changes.
RUN --mount=type=cache,id=mdk-openclaw-target,target=/work/mdk/target,sharing=locked \
    cargo build --locked --release -p agent-connector --bin wn-agent \
    && install -m 0755 target/release/wn-agent /usr/local/bin/wn-agent \
    && install -m 0755 scripts/openclaw_marmot_container_entrypoint.sh /usr/local/bin/openclaw-marmot-entrypoint \
    && mkdir -p /opt/marmot-plugin \
    && ( cd integrations/openclaw/marmot && pnpm build && pnpm pack --pack-destination /opt/marmot-plugin )

# Development phone-test image only. Do not copy the permissive invite/debug
# controls below into a production image; use an explicit invite allowlist and
# omit both MARMOT_AGENT_DEV_ALLOW_ANY_INVITES and MARMOT_AGENT_DEBUG_CONTROLS.
ENV MARMOT_HOME=/data/marmot-agent \
    OPENCLAW_HOME=/data/openclaw-home \
    MARMOT_AGENT_SOCKET=/run/marmot-agent/wn-agent.sock \
    MARMOT_AGENT_AUTH_TOKEN_FILE=/data/marmot-agent/control.token \
    MARMOT_AGENT_SOCKET_DIR_MODE=0770 \
    MARMOT_AGENT_SOCKET_MODE=0660 \
    MARMOT_OUTBOUND_MEDIA_DIR=/run/marmot-media/outbound \
    MARMOT_AGENT_DEV_ALLOW_ANY_INVITES=1 \
    MARMOT_AGENT_DEBUG_CONTROLS=1 \
    MARMOT_RELAYS=wss://relay.eu.whitenoise.chat,wss://relay.us.whitenoise.chat \
    MARMOT_QUIC_CANDIDATES=quic://quic-broker.ipf.dev:4450 \
    PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/openclaw-marmot-entrypoint"]
