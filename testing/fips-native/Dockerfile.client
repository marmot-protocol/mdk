FROM rust:1.97.1-slim-trixie AS mdk-builder

ARG FIPS_GIT_REV=1ec62e51192a3ed49792e177c8c88d8176647133
ENV RUSTUP_TOOLCHAIN=1.97.1
ENV CARGO_TARGET_DIR=/build/target

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        git \
        libclang-dev \
        libdbus-1-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src/mdk
COPY . .
RUN grep -Fq "${FIPS_GIT_REV}" Cargo.lock && \
    cargo build --release --locked \
        -p transport-fips-native --example relay-smoke \
        -p wn-cli --bins

FROM rust:1.97.1-slim-trixie AS fips-builder

ARG FIPS_GIT_REV=1ec62e51192a3ed49792e177c8c88d8176647133
ENV RUSTUP_TOOLCHAIN=1.97.1
ENV CARGO_TARGET_DIR=/build/target

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        git \
        libclang-dev \
        libdbus-1-dev \
        pkg-config && \
    rm -rf /var/lib/apt/lists/*

RUN git init /src/fips && \
    git -C /src/fips remote add origin https://github.com/jmcorgan/fips.git && \
    git -C /src/fips fetch --depth 1 origin "${FIPS_GIT_REV}" && \
    git -C /src/fips checkout --detach FETCH_HEAD && \
    test "$(git -C /src/fips rev-parse HEAD)" = "${FIPS_GIT_REV}"

WORKDIR /src/fips
RUN cargo build --release --locked --bin fips --bin fipsctl

FROM debian:trixie-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl jq libdbus-1-3 python3 tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --system fips && \
    install -d -o root -g fips -m 0750 /run/fips /etc/fips /var/lib/mdk

COPY --from=mdk-builder /build/target/release/examples/relay-smoke /usr/local/bin/mdk-fips-relay-smoke
COPY --from=mdk-builder /build/target/release/wn /usr/local/bin/wn
COPY --from=mdk-builder /build/target/release/wnd /usr/local/bin/wnd
COPY --from=fips-builder /build/target/release/fips /usr/local/bin/fips
COPY --from=fips-builder /build/target/release/fipsctl /usr/local/bin/fipsctl
COPY testing/fips-native/demo-client-fips.yaml /usr/share/mdk-fips/demo-client-fips.yaml
COPY testing/fips-native/benchmark.py /usr/local/bin/mdk-relay-benchmark
COPY --chmod=0755 testing/fips-native/tui-demo.sh /usr/local/bin/mdk-fips-tui-demo

ENTRYPOINT []
