{
  "name": "@marmot-protocol/openclaw-marmot",
  "version": "0.9.3",
  "description": "OpenClaw channel plugin for Marmot through the local wn-agent control socket",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "marmot",
      "label": "Marmot",
      "blurb": "End-to-end encrypted Marmot groups through the local wn-agent connector."
    }
  },
  "files": ["dist", "index.ts", "setup-entry.ts", "src", "openclaw.plugin.json", "manifest.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoketest": "node ./scripts/wn-agent-smoketest.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.6.0",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.5",
      "hono": "4.13.1",
      "ip-address": "10.5.0",
      "postcss": "8.5.26",
      "protobufjs": "7.6.5",
      "tar": "7.5.22",
      "undici": "8.10.0",
      "vite": "6.4.3"
    }
  }
}
