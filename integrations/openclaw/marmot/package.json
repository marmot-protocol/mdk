{
  "name": "@marmot-protocol/openclaw-marmot",
  "version": "0.9.3",
  "description": "OpenClaw channel plugin for Marmot through the local wn-agent control socket",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "marmot",
      "label": "Marmot",
      "blurb": "End-to-end encrypted Marmot groups through the local wn-agent connector."
    }
  },
  "files": ["dist", "index.ts", "setup-entry.ts", "src", "openclaw.plugin.json", "manifest.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoketest": "node ./scripts/wn-agent-smoketest.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.6.0",
    "vite": "6.4.5",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.3",
      "@modelcontextprotocol/sdk": "1.32.0",
      "body-parser": "2.4.0",
      "brace-expansion": "5.0.12",
      "fast-uri": "3.1.9",
      "glob": "14.0.2",
      "hono": "4.13.11",
      "ip-address": "10.7.4",
      "minimatch": "11.0.1",
      "postcss": "8.5.26",
      "protobufjs": "7.6.5",
      "proxy-addr": "2.0.8",
      "qs": "6.16.1",
      "source-map-js": "1.2.2",
      "tar": "7.5.22",
      "undici": "8.12.2",
      "vite": "6.4.5",
      "zod": "4.6.6"
    }
  }
}
