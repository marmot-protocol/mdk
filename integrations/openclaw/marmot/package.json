{
  "name": "@marmot-protocol/openclaw-marmot",
  "version": "0.9.3",
  "description": "OpenClaw channel plugin for Marmot through the local wn-agent control socket",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "marmot",
      "label": "Marmot",
      "blurb": "End-to-end encrypted Marmot groups through the local wn-agent connector."
    },
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "install": {
      "minHostVersion": ">=2026.10.10"
    },
    "compat": {
      "pluginApi": ">=2026.10.10"
    }
  },
  "files": ["dist", "index.ts", "setup-entry.ts", "src", "openclaw.plugin.json", "manifest.json", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoketest": "node ./scripts/wn-agent-smoketest.ts",
    "pretest": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.16.0",
    "openclaw": "2026.10.10",
    "typescript": "^5.6.0",
    "vite": "6.4.5",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.10"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "minimatch": "11.0.1",
      "zod": "4.6.6"
    }
  }
}
